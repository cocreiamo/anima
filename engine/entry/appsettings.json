{
    "AllowedHosts": "*",
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Yarp": "Warning"
        }
    },
    "ReverseProxy": {
        "Routes": {
            "identity-provider-realms": {
                "ClusterId": "identity-provider",
                "Match": {
                    "Path": "/realms/{realm:regex(^(?!master$).+$)}/{**rest}"
                },
                "Transforms": [
                    {
                        "Forwarded": "for,host,proto",
                        "ForFormat": "IP",
                        "Action": "Set"
                    },
                    { "RequestHeaderRemove": "X-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Forwarded-Host" },
                    { "RequestHeaderRemove": "X-Forwarded-Proto" },
                    { "RequestHeaderRemove": "X-Forwarded-Port" },
                    { "RequestHeaderRemove": "X-Forwarded-Prefix" },
                    { "RequestHeaderRemove": "X-Forwarded-Server" },
                    { "RequestHeaderRemove": "X-Forwarded-Ssl" },
                    { "RequestHeaderRemove": "X-Original-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Real-IP" },
                    { "RequestHeaderRemove": "Front-End-Https" },
                    { "RequestHeaderRemove": "X-Url-Scheme" }
                ]
            },
            "identity-provider-resources": {
                "ClusterId": "identity-provider",
                "Match": { "Path": "/resources/{**rest}" },
                "Transforms": [
                    {
                        "Forwarded": "for,host,proto",
                        "ForFormat": "IP",
                        "Action": "Set"
                    },
                    { "RequestHeaderRemove": "X-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Forwarded-Host" },
                    { "RequestHeaderRemove": "X-Forwarded-Proto" },
                    { "RequestHeaderRemove": "X-Forwarded-Port" },
                    { "RequestHeaderRemove": "X-Forwarded-Prefix" },
                    { "RequestHeaderRemove": "X-Forwarded-Server" },
                    { "RequestHeaderRemove": "X-Forwarded-Ssl" },
                    { "RequestHeaderRemove": "X-Original-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Real-IP" },
                    { "RequestHeaderRemove": "Front-End-Https" },
                    { "RequestHeaderRemove": "X-Url-Scheme" }
                ]
            },
            "identity-provider-well-known": {
                "ClusterId": "identity-provider",
                "Match": { "Path": "/.well-known/{**rest}" },
                "Transforms": [
                    {
                        "Forwarded": "for,host,proto",
                        "ForFormat": "IP",
                        "Action": "Set"
                    },
                    { "RequestHeaderRemove": "X-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Forwarded-Host" },
                    { "RequestHeaderRemove": "X-Forwarded-Proto" },
                    { "RequestHeaderRemove": "X-Forwarded-Port" },
                    { "RequestHeaderRemove": "X-Forwarded-Prefix" },
                    { "RequestHeaderRemove": "X-Forwarded-Server" },
                    { "RequestHeaderRemove": "X-Forwarded-Ssl" },
                    { "RequestHeaderRemove": "X-Original-Forwarded-For" },
                    { "RequestHeaderRemove": "X-Real-IP" },
                    { "RequestHeaderRemove": "Front-End-Https" },
                    { "RequestHeaderRemove": "X-Url-Scheme" }
                ]
            }
        },
        "Clusters": {
            "identity-provider": {
                "Destinations": {
                    "identity-provider": { "Address": "http://127.0.0.1:8080/" }
                }
            }
        }
    }
}
