[Unit]
Description=Anima secret store
# Order: the database server and the storage role (database-prepare), then the
# secret store, which unseals from the stand-in root of trust.
Requires=secrets-root-of-trust.service anima-credentials.service database-prepare.service
After=secrets-root-of-trust.service anima-credentials.service database-prepare.service

[Container]
ContainerName=secrets
Image=secrets.image
Pod=anima.pod
# The secret store's operating system user is a dedicated one; the database
# server maps it to the role that owns the store's own database (peer).
User=1010:1010
Volume=/run/anima/pgsocket:/run/anima/pgsocket
Volume=/var/lib/anima/root-of-trust:/var/lib/anima/root-of-trust:ro,U
Volume=/etc/anima/secrets:/openbao/config:ro
ReadOnly=true
Tmpfs=/tmp:rw,mode=1777
# The API listens only on the pod's loopback, without TLS, and is never
# published (ADR 0005). Address for the command line client of the checks:
Environment=BAO_ADDR=http://127.0.0.1:8200
# The configurator's machine credential, derived from the root of trust (anima-credentials).
EnvironmentFile=/run/anima/configurator/secrets.env
# Startup, liveness and readiness. `bao status` exits 0 only when the server is
# initialized and unsealed, so a sealed store is never ready.
HealthStartupCmd=bao status
HealthStartupInterval=2s
HealthStartupRetries=60
HealthCmd=bao status
HealthInterval=5s
HealthTimeout=4s
HealthRetries=2
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=2
TimeoutStartSec=180
