#!/usr/bin/env bash
#MISE description="Export a SysML v2 file to JSON (cached by hash) and print the path of the JSON file"
#
# Export a SysML v2 file to JSON with the OMG SysML v2 Pilot Implementation
# and print the path of the JSON file.
#
# Usage: mise run model:export [file.sysml]   (default: model/anima.sysml)
set -euo pipefail

: "${SYSML_PILOT_VERSION:?set in mise.toml}"

root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
input="$(realpath "${1:-$root/model/anima.sysml}")"
# GAP-003, PM-003: the exporter names its output by cutting the input path at the
# first dot, so it is given a bare file name and run from the directory that
# holds it.
# Each export starts the pilot's JVM, which is slow, so the result is cached
# under .cache/sysml-export/<pilot version>/<SHA-256 of the input>/. A run that
# finds the cache prints its path and does nothing else. The cache is never
# stale: a changed input has another hash. Callers must not delete it.
#
# Safe under parallel runs: a run exports in a directory of its own and then
# moves it into place in one step. If another run got there first the move
# fails, and this run discards its copy and prints the one in place.
hash="$(sha256sum "$input" | cut -d' ' -f1)"
base="$root/.cache/sysml-export"
cached="$base/$SYSML_PILOT_VERSION/$hash"
if [ -f "$cached/model.json" ]; then
    echo "$cached/model.json"
    exit 0
fi

# The one place that fetches the pilot, safe in parallel (PM-007). It also
# gives the library its aliases for GAP-002. A run that finds the cache above
# never waits for it.
pilot="$("$root/mise-tasks/model/fetch")"
jar="$pilot/jupyter-sysml-kernel-$SYSML_PILOT_VERSION-all.jar"
lib="$pilot/sysml.library"

mkdir -p "$base" "$base/$SYSML_PILOT_VERSION"
out="$(mktemp -d "$base/run.XXXXXX")"
trap 'rm -rf "$out"' EXIT
cp "$input" "$out/model.sysml"
cd "$out"
if ! timeout 300 java -cp "$jar" org.omg.sysml.xtext.util.SysML2JSON \
        -l "$lib" model.sysml \
        "Kernel Libraries" "Systems Library" "Domain Libraries" \
        > "$out/output.txt" 2>&1 || [ ! -f "$out/model.json" ]; then
    grep -v '^log4j' "$out/output.txt" >&2
    echo "model:export: the pilot implementation did not produce the JSON" >&2
    exit 1
fi
# `mv -T` onto an existing non-empty directory fails; the trap then removes ours.
mv -T "$out" "$cached" 2>/dev/null || [ -f "$cached/model.json" ]
echo "$cached/model.json"
