# The secret store, built from the fork.
#
# Stage `bin` is upstream's build (the Makefile's `bin` target calls
# scripts/build.sh, which is `go build -tags ...`; the submodule has no usable
# .git inside the build context, so the same `go build` is run with the
# version stamped from the pinned commit). The server stage is upstream's own
# container file (Dockerfile, target `default`, on Alpine) with the binary taken
# from the stage above.
#
# Build context: the repository root; `openbao` is a named build context for
# third_party/openbao. The UI is not built: the server is configured through its
# API and declarations only.

ARG GOLANG=docker.io/library/golang:1.27@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666
ARG ALPINE=docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

FROM ${GOLANG} AS bin
ARG SOURCE_COMMIT_OPENBAO
COPY --from=openbao / /src/openbao
WORKDIR /src/openbao
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-X github.com/openbao/openbao/v2/internal/version.GitCommit=${SOURCE_COMMIT_OPENBAO}" \
      -tags openbao -o /out/bao . \
 && /out/bao version

FROM ${ALPINE} AS server
ARG SOURCE_COMMIT_OPENBAO
COPY --from=openbao /LICENSE /licenses/mozilla.txt
RUN addgroup openbao && adduser -S -G openbao openbao \
 && apk add --no-cache ca-certificates libcap su-exec dumb-init tzdata gcompat
COPY --from=bin --chmod=555 /out/bao /usr/bin/bao
RUN ln -s /usr/bin/bao /usr/bin/vault \
 && mkdir -p /openbao/logs /openbao/file /openbao/config \
 && chown -R openbao:openbao /openbao
LABEL org.opencontainers.image.title="anima secret store" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.anima.source.openbao="${SOURCE_COMMIT_OPENBAO}"
EXPOSE 8200
USER openbao
ENTRYPOINT ["/usr/bin/bao"]
CMD ["server", "-config=/openbao/config"]
