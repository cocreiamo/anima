[Unit]
Description=Anima engine ready
Documentation=file:///usr/share/doc/anima/readiness
# The single readiness answer (R41). Active only while every unit below is
# active. A container unit is active only when its startup check has passed
# (Notify=healthy) and it leaves that state when its liveness check fails. The
# run-to-completion units hold the target back until they have succeeded.
Requires=database.service access.service secrets.service database-tls.service entry.service entry-certificate.service configure.service
BindsTo=database.service access.service secrets.service database-tls.service entry.service entry-certificate.service configure.service
After=database.service access.service secrets.service database-tls.service entry.service entry-certificate.service configure.service

# No start limit: the target is started again every time a part returns.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
