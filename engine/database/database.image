[Unit]
Description=Anima database server image, loaded from the archive in the engine image

[Image]
# The engine image carries each inner image as an OCI archive (an image store
# cannot be shipped inside an image layer). Loading it is this unit; every
# container of the image depends on it, so nothing is fetched from a registry.
Image=oci-archive:/usr/lib/anima/images/database.tar
ImageTag=localhost/anima/database:engine

[Service]
# The envelope of the class `image-load` of engine/image/envelopes.toml (R203 proves it equal).
MemoryMax=512M
CPUQuota=100%
TasksMax=128
TimeoutStartSec=300
