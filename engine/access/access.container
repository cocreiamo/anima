[Unit]
Description=Anima identity provider (production mode, behind a TLS-terminating entry point to come)
# The identity provider keeps its state in its own database of the database
# server, as the role prepared before the configurator (database-prepare); the
# database server does not need the identity provider (R13). Its start order is
# declared, never obtained by restarts.
Requires=anima-listen-container.service anima-listen-host.service anima-credentials.service database-prepare.service
After=anima-credentials.service anima-listen-container.service anima-listen-host.service database.service secrets.service database-tls.service database-prepare.service
# Ordering only (no Requires) for the secret store and the certificate: two
# `podman run` into the same pod at the same moment were seen to hang each other,
# so the starts are serialised: it starts after the others.

[Container]
ContainerName=access
Image=access.image
EnvironmentFile=/run/anima/listen/access.env
# The temporary administrator (a service account) and the database password,
# derived into memory from the root of trust.
EnvironmentFile=/run/anima/configurator/access.env
Environment=KC_HTTP_MANAGEMENT_HOST=127.0.0.1
# Plain HTTP inside the pod: a TLS-terminating entry point in front of it is a
# task of its own. The headers that such a proxy sets are not trusted until then
# (no proxy-headers setting), and the hostname is the public URL, never the
# request's name (R116).
Environment=KC_HTTP_ENABLED=true
Environment=KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/idp
Environment=KC_DB_USERNAME=svc_idp
Pod=anima.pod
# Production mode on the image's optimized build; the state is in the database.
Exec=start --optimized --http-port=8080 --hostname=${ANIMA_IDENTITY_PROVIDER_URL}
Mount=type=tmpfs,destination=/opt/keycloak/data,tmpfs-mode=1777
Tmpfs=/tmp:rw,mode=1777
# Startup, liveness and readiness through the management port (no curl in the
# image: the shell's own TCP redirection is used).
# In production mode the server answers 503 on its main port while it bootstraps
# (schema, master realm), after its readiness endpoint is already up; so startup
# waits until the master realm is served, which is what the configurator needs.
HealthStartupCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /realms/master HTTP/1.0\r\nHost: 127.0.0.1:8080\r\n\r\n" >&3 && grep -q "^HTTP/1.[01] 200" <&3'
HealthStartupInterval=3s
HealthStartupRetries=100
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/9000 && printf "GET /health/ready HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n" >&3 && grep -q "\"status\": \"UP\"" <&3'
HealthInterval=5s
HealthTimeout=4s
HealthRetries=2
HealthOnFailure=kill
Notify=healthy

[Service]
# The public URL: the installation parameter, declared once (the configurator reads
# the same file). A service-level file, so that systemd expands it in Exec above.
EnvironmentFile=/usr/share/anima/public-url.env
Restart=always
RestartSec=2
TimeoutStartSec=300
