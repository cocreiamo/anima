[Unit]
Description=Anima secret store: local stand-in root of trust (generated at first start)
# The stand-in of the external key management service (ADR 0009, ADR 0011): a
# local key that does not protect data at rest. It is generated here, on this
# machine, when it does not exist; it is never in an image or a repository.
ConditionPathExists=!/var/lib/anima/root-of-trust/seal

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStartPre=/usr/bin/mkdir -p /var/lib/anima/root-of-trust
# 32 random bytes, written to a temporary name and moved into place, so that an
# abrupt stop never leaves a half-written key behind (R42).
ExecStart=/usr/bin/dd if=/dev/urandom of=/var/lib/anima/root-of-trust/seal.tmp bs=32 count=1 status=none
ExecStart=/usr/bin/mv /var/lib/anima/root-of-trust/seal.tmp /var/lib/anima/root-of-trust/seal
