#!/usr/bin/env bash
#MISE description="Print value=<key>, the key of the inner images' cache: a hash of the submodule status and of the files that the images are made of"
#
# Usage: mise run ci:cache-key [directory]
# The directory (default: the repository) is where the status and the files are
# read, so that a test can compute the key on a throwaway repository.
set -euo pipefail

cd "${1:-${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}}"

key=$(
    {
        git submodule status
        find engine mise-tasks/engine config -type f | LC_ALL=C sort | xargs sha256sum
    } | sha256sum | cut -c1-16
)
echo "value=$key"
