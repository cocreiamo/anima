#!/usr/bin/env bash
#MISE description="Write the generated files, then format Anima's own files (waits for running tests)"
#
# Takes the lock that `mise run test` shares (PM-006): the formatter rewrites files
# in place, and a test session reads them. Exclusive here, shared there, so a
# format run waits for every running test session and a test session waits for a
# running format run. The lock covers the generated files too, which the tests read.
set -euo pipefail

root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$root"
mkdir -p .cache
exec 9>.cache/format-test.lock
flock -x 9

mise run generate
ruff format .
buildifier MODULE.bazel BUILD.bazel
prettier --write .
taplo fmt
