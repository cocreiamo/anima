{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>cocreiamo/.github"],
    "git-submodules": {
        "enabled": false
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Images listed in components.toml, shipped or used only by tools and tests",
            "managerFilePatterns": ["/^components\\.toml$/"],
            "matchStrings": [
                "version = \"(?<currentValue>[^\"]+)\"\\n(?:[a-z_]+ = .*\\n)*?image = \"(?<depName>[^\"]+)\"\\ndigest = \"(?<currentDigest>sha256:[0-9a-f]+)\""
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "The configurator's exact version constraint in its declarations: OpenTofu, not HashiCorp Terraform",
            "managerFilePatterns": ["/^engine\\/configure\\/.+\\.tf$/"],
            "matchStrings": [
                "required_version = \"= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
            ],
            "depNameTemplate": "opentofu/opentofu",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.+)$"
        },
        {
            "customType": "regex",
            "description": "The task runner's version, where the built-in managers do not read it: the reusable workflow's input and the development container's feature",
            "managerFilePatterns": [
                "/^\\.github\\/workflows\\/ci\\.yml$/",
                "/^\\.devcontainer\\/devcontainer\\.json$/"
            ],
            "matchStrings": [
                "mise-version: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)",
                "features/mise@sha256:[0-9a-f]+\": \\{\\s*\"version\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
            ],
            "depNameTemplate": "jdx/mise",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.+)$"
        }
    ],
    "packageRules": [
        {
            "description": "The declarations require OpenTofu: the built-in manager would take the constraint for HashiCorp Terraform's and drop its exact pin",
            "matchManagers": ["terraform"],
            "matchDepTypes": ["required_version"],
            "enabled": false
        },
        {
            "description": "The configurator's version in the declarations, its register entry and its image move together",
            "matchDepNames": ["opentofu/opentofu", "ghcr.io/opentofu/opentofu"],
            "groupName": "opentofu"
        },
        {
            "description": "The task runner's version is pinned in four files: one update changes them all",
            "matchDepNames": ["jdx/mise"],
            "groupName": "mise"
        },
        {
            "description": "Names given at build time (--build-context) to the pinned sources, not images of a registry",
            "matchManagers": ["dockerfile"],
            "matchPackageNames": [
                "images",
                "keycloak",
                "openbao",
                "pg_oidc_validator",
                "pgbackrest",
                "pgvector",
                "postgres",
                "rules"
            ],
            "enabled": false
        }
    ]
}
