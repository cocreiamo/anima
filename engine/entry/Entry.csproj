<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP entry point's host program (ADR 0008): it loads the forwarding
       library and its configuration, and nothing else. The library is pinned by
       version here and by the content hash of its package in packages.lock.json
       and in components.toml (GAP-057). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>entry</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="[2.3.0]" />
  </ItemGroup>

</Project>
