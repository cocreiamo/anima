# The secret store's own first-start declaration of the configurator's machine
# authentication: the configurator cannot create its own way in. It is read by
# the secret store from its configuration directory, beside its other
# declarations, and runs once on empty storage (self-initialization).
#
# The role id is fixed; the secret id is generated by the first start and arrives
# in the environment of the secret store, never in this file. The configurator
# holds only what it needs to declare the secret store's policies, machine
# authentication, certificate role and database secrets engine; the certificate
# authority and the engines of the first start are not among them.

initialize "configurator-access" {
  request "policy" {
    operation = "update"
    path      = "sys/policies/acl/configurator"
    data = {
      policy = <<-EOT
        # Policies and the machine authentication of the services.
        path "sys/policy/*"         { capabilities = ["create", "read", "update", "delete"] }
        path "sys/policies/acl/*"   { capabilities = ["create", "read", "update", "delete", "list"] }
        path "sys/policies/acl"     { capabilities = ["list"] }
        path "sys/auth"             { capabilities = ["read", "list"] }
        path "auth/approle/role/*"  { capabilities = ["create", "read", "update", "delete", "list"] }
        # The certificate role, on the mount that the first start made.
        path "pki/roles/*"          { capabilities = ["create", "read", "update", "delete", "list"] }
        # The database secrets engine and its static roles.
        path "sys/mounts"           { capabilities = ["read", "list"] }
        path "sys/mounts/database"  { capabilities = ["create", "read", "update", "delete", "sudo"] }
        path "sys/mounts/database/tune" { capabilities = ["read", "update", "sudo"] }
        path "database/*"           { capabilities = ["create", "read", "update", "delete", "list"] }
      EOT
    }
  }
  request "mount" {
    operation = "update"
    path      = "sys/auth/configurator"
    data = {
      type = "approle"
    }
  }
  request "role" {
    operation = "update"
    path      = "auth/configurator/role/configurator"
    data = {
      token_policies = ["configurator"]
      token_ttl      = 600
      token_max_ttl  = 1800
    }
  }
  request "role-id" {
    operation = "update"
    path      = "auth/configurator/role/configurator/role-id"
    data = {
      role_id = "configurator"
    }
  }
  request "secret-id" {
    operation = "update"
    path      = "auth/configurator/role/configurator/custom-secret-id"
    data = {
      secret_id = {
        eval_type       = "string"
        eval_source     = "env"
        env_var         = "CONFIGURATOR_SECRET_ID"
        require_present = true
      }
    }
  }
}
