[Unit]
Description=Anima credentials the parts hand to each other, derived from the root of trust into memory
Requires=secrets-root-of-trust.service
After=secrets-root-of-trust.service
Before=secrets.service access.service database-prepare.service

[Service]
# The envelope of the class `host-oneshot` of engine/image/envelopes.toml (R203 proves it equal).
MemoryMax=64M
CPUQuota=100%
TasksMax=64
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/anima/credentials
