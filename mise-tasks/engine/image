#!/usr/bin/env bash
#MISE description="Build the engine image (operating system, units and the inner images as archives)"
#MISE depends=["engine:build", "engine:configure-build"]
#
# Exports each inner image to an OCI archive, then builds engine/image/Containerfile
# with the archives as the named build context `images`. The tag is a hash of
# the inner image ids and of every file the engine image copies, so an
# unchanged engine image is not built again. Reference: .cache/engine/engine.ref
set -euo pipefail

root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
cd "$root"
out=.cache/engine
mkdir -p "$out/oci" "$out/logs"

podman image inspect --format "{{.Id}}" "$(cat "$out/configure.ref")" >"$out/configure.id"
for name in database access secrets mail configure; do
    ref=$(cat "$out/$name.ref")
    if [ ! -f "$out/oci/$name.ref" ] || [ "$(cat "$out/oci/$name.ref")" != "$ref" ]; then
        rm -f "$out/oci/$name.tar"
        podman tag "$ref" "localhost/anima/$name:engine"
        podman save --format oci-archive --output "$out/oci/$name.tar" "localhost/anima/$name:engine"
        echo "$ref" >"$out/oci/$name.ref"
    fi
done

tag=$(
    {
        cat "$out"/database.id "$out"/access.id "$out"/secrets.id "$out"/mail.id "$out"/configure.id
        find engine/image engine/database engine/access engine/secrets engine/mail engine/configure/secret-store-bootstrap.hcl -type f ! -name Containerfile.* | sort | xargs cat
    } | sha256sum | cut -c1-12
)
image="localhost/anima/engine:$tag"
if podman image exists "$image"; then
    echo "engine: up to date ($image)"
else
    echo "engine: building $image (log: $out/logs/build-engine.log)"
    start=$SECONDS
    podman build --format docker --file engine/image/Containerfile --tag "$image" \
        --build-context "images=$out/oci" . >"$out/logs/build-engine.log" 2>&1 || {
        echo "engine: FAILED, last lines of the log:" >&2
        tail -n 30 "$out/logs/build-engine.log" >&2
        exit 1
    }
    echo "engine: built in $((SECONDS - start)) s"
fi
echo "$image" >"$out/engine.ref"
podman image inspect --format '{{.Id}}' "$image" >"$out/engine.id"
