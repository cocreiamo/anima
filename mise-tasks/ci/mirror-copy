#!/usr/bin/env bash
#MISE description="Copy one image into the organization's mirror: the digest that the upstream tag names now and the pinned digest, whole, with the digest kept, under tags that are never moved"
#
# Environment (the workflow sets all of them): SKOPEO (the pinned reference of the
# copy tool), NAME, IMAGE (upstream, without tag), TAG, DIGEST (pinned, sha256:...),
# MIRROR (the package of the mirror), REGISTRY_TOKEN and ACTOR (the credentials of
# the mirror's registry), RUNNER_TEMP, GITHUB_STEP_SUMMARY.
# For a registry on a development machine: ANIMA_MIRROR_INSECURE=1 (no TLS) and
# ANIMA_MIRROR_NETWORK=<podman network of the copy tool>.
#
# For each image it copies the digest that the upstream tag names now, and the
# pinned digest, whole (every platform) and with the digest preserved: a copy that
# cannot keep the digest, or whose result differs, fails. Each copy is reachable by
# two tags that are never moved: `sha256-<hex>` is the digest itself, and
# `<tag>-<UTC date>` is the day's copy of the upstream tag. The tag that is the
# upstream tag itself follows it, once the digest is held under its own tags: the
# update bot reads the digest of that tag, so it finds only digests that the mirror
# holds. Nothing is deleted.
set -euo pipefail

: "${SKOPEO:?} ${NAME:?} ${IMAGE:?} ${TAG:?} ${DIGEST:?} ${MIRROR:?} ${REGISTRY_TOKEN:?} ${ACTOR:?}"

work="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/mirror-copy.XXXXXX")"
trap 'rm -rf "$work"' EXIT
auth="$work/auth.json"

tls=()
net=()
if [ "${ANIMA_MIRROR_INSECURE:-}" = 1 ]; then
    tls=(--tls-verify=false)
fi
if [ -n "${ANIMA_MIRROR_NETWORK:-}" ]; then
    net=(--network "$ANIMA_MIRROR_NETWORK")
fi

echo "$REGISTRY_TOKEN" | podman login "${MIRROR%%/*}" --username "$ACTOR" --password-stdin --authfile "$auth" "${tls[@]}"

# Some upstream images are signed (Red Hat's carry signatures stored as
# attachments next to the image). The copy keeps them: the tool reads and
# writes attachments only where its registries configuration enables it,
# so it is enabled for the upstream scope and for the mirror's. The tool's
# policy may require the signatures of an upstream, so they must be read.
# Without this the copy of a signed image fails after its manifest is
# written ("writing sigstore attachments is disabled by configuration",
# first run, 2026-11-28). Not stripping them in the copy: it drops what
# the upstream signed, and the digest is the same either way (observed).
rd="$work/registries.d"
mkdir "$rd"
cat >"$rd/mirror.yaml" <<EOF
docker:
  $IMAGE:
    use-sigstore-attachments: true
  $MIRROR:
    use-sigstore-attachments: true
EOF

# The copy tool is a pinned image; only the credentials file and the
# configuration reach it, read only, and only the destination is given
# the credentials.
sk() { podman run --rm "${net[@]}" --volume "$auth:/auth.json:ro" --volume "$rd:/rd:ro" "$SKOPEO" --registries.d /rd "$@"; }

die() {
    echo "::error::$*" >&2
    exit 1
}

# The digest (hex) of the manifest that a reference names: empty when the
# registry says there is none, a failure on any other answer. The raw
# manifest is what a digest is the hash of.
manifest_hex() {
    local ref="$1"
    shift
    local err="$work/answer.err" hex="$work/answer.hex"
    if sk inspect --raw "${tls[@]}" "$@" "docker://$ref" 2>"$err" | sha256sum | cut -d ' ' -f 1 >"$hex"; then
        cat "$hex"
    elif grep -Eq 'manifest unknown|name unknown|not found|404' "$err"; then
        echo ""
    else
        cat "$err" >&2
        die "cannot read $ref"
    fi
}

# Writes a source (a reference by digest) into the mirror under a tag, whole
# and with its digest, and reads the result back. The only place that writes.
write() {
    local source="$1" tag="$2" hex="$3" held
    local copy_tls=()
    if [ "${#tls[@]}" -gt 0 ]; then
        copy_tls=(--src-tls-verify=false --dest-tls-verify=false)
    fi
    sk copy --all --preserve-digests --retry-times 3 --src-no-creds --dest-authfile /auth.json "${copy_tls[@]}" "docker://$source" "docker://$MIRROR:$tag"
    held="$(manifest_hex "$MIRROR:$tag" --authfile /auth.json)"
    [ "$held" = "$hex" ] || die "$MIRROR:$tag holds sha256:$held after the copy, not sha256:$hex: the digest was not preserved"
    echo "$MIRROR:$tag now holds sha256:$hex."
}

# Puts a source into the mirror under a tag that is never moved. A tag that
# exists is left alone: a day's tag that names another digest is kept, a digest
# tag that does (it cannot) is a fault.
put() {
    local source="$1" tag="$2" hex="$3" held
    held="$(manifest_hex "$MIRROR:$tag" --authfile /auth.json)"
    if [ "$held" = "$hex" ]; then
        echo "$MIRROR:$tag already holds sha256:$hex."
        return 0
    elif [ -n "$held" ]; then
        case "$tag" in
        sha256-*) die "$MIRROR:$tag holds sha256:$held, not the digest it is named for" ;;
        esac
        echo "::warning::$MIRROR:$tag holds sha256:$held, not sha256:$hex: left as it is, a tag is never moved."
        return 0
    fi
    write "$source" "$tag" "$hex"
}

# Moves the tag that is the upstream tag itself to the digest that it names now,
# so that the update bot, which reads a digest by tag, finds there only a digest
# that the mirror holds (R162). It is the one tag that is moved, and only after
# the digest is held under its own immutable tag, so that the image it named
# before stays reachable by that tag and by its digest.
follow() {
    local source="$1" tag="$2" hex="$3" held
    held="$(manifest_hex "$MIRROR:$tag" --authfile /auth.json)"
    if [ "$held" = "$hex" ]; then
        echo "$MIRROR:$tag already holds sha256:$hex."
        return 0
    fi
    write "$source" "$tag" "$hex"
}

today="$(date -u +%Y%m%d)"
current="$(manifest_hex "$IMAGE:$TAG" --no-creds)"
[ -n "$current" ] || die "$IMAGE:$TAG does not exist upstream any more"
put "$IMAGE@sha256:$current" "sha256-$current" "$current"
put "$IMAGE@sha256:$current" "$TAG-$today" "$current"
follow "$IMAGE@sha256:$current" "$TAG" "$current"

pinned="${DIGEST#sha256:}"
put "$IMAGE@sha256:$pinned" "sha256-$pinned" "$pinned"

echo "- $NAME: $TAG is sha256:$current upstream today, pinned sha256:$pinned; both are in $MIRROR." | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
