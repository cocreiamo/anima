# The identity provider, built from the fork.
#
# Stage `dist` is upstream's documented build of the server distribution
# (third_party/keycloak/docs/building.md: mvn -pl quarkus/deployment,quarkus/dist
# -am -DskipTests clean install), run with the Maven that the builder image
# holds: the source's wrapper would download Maven once, with no retry and no
# checksum, and a failure of that download failed a release (PM-014, R165).
# The builder's Maven version equals the one the wrapper names (R165). The
# dependency downloads that remain retry, bounded, through Maven's own settings
# (R166). The final stage is upstream's own container
# file (quarkus/container/Dockerfile) with its two base images pinned by digest
# and its distribution taken from the stage above instead of a download.
#
# Build context: the repository root. `keycloak` is a named build context for
# third_party/keycloak. The Maven repository is kept in a directory that
# `mise run engine:build` mounts at /root/.m2 (.cache/engine/m2), so that a
# rebuild does not download everything again.

ARG BUILDER=docker.io/library/maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
ARG UBI=registry.access.redhat.com/ubi9:9.9-1795197514@sha256:6636b79fba9e5044360366f189333c30b5ce528efd92c40c68b074592b971fcd
ARG UBI_MICRO=registry.access.redhat.com/ubi9-micro:9.9-1794478307@sha256:dbd325b96bcd432dd42816d31412bdf1dc0fb973b79ed310344bc23c76c068db

FROM ${BUILDER} AS dist
# The Administration UI build runs a .NET tool (Kiota) that needs ICU.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libicu-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=keycloak / /src/keycloak
WORKDIR /src/keycloak
# The submodule's .git is a pointer outside the build context: skip what reads it.
# Retries of the resolver's HTTP transport (maven-resolver 1.9.27, the version of
# this Maven; its configuration page): ten retries, with a first wait of 5 s that
# grows by 5 s on each, and the status codes that mean "try later". The Node,
# pnpm and npm downloads of the Administration UI build belong to the frontend
# plugin; npm retries its own fetches `npm_config_fetch_retries` times.
ENV npm_config_fetch_retries=5
RUN mvn -B -pl quarkus/deployment,quarkus/dist -am -DskipTests -DskipTestsuite -DskipExamples \
      -Dmaven.gitcommitid.skip=true \
      -Daether.connector.http.retryHandler.count=10 \
      -Daether.connector.http.retryHandler.interval=5000 \
      -Daether.connector.http.retryHandler.serviceUnavailable=429,502,503,504 \
      clean install \
 && mkdir -p /out && cp quarkus/dist/target/keycloak-*.tar.gz /out/

FROM ${UBI} AS ubi-micro-build
ARG KEYCLOAK_VERSION
RUN dnf install -y tar gzip
COPY --from=dist /out/keycloak-*.tar.gz /tmp/keycloak/
RUN cd /tmp/keycloak && tar -xf keycloak-*.tar.gz && rm keycloak-*.tar.gz \
 && mv /tmp/keycloak/keycloak-* /opt/keycloak && mkdir -p /opt/keycloak/data \
 && chmod -R g+rwX /opt/keycloak
COPY --from=keycloak /quarkus/container/ubi-null.sh /tmp/
RUN bash /tmp/ubi-null.sh java-21-openjdk-headless glibc-langpack-en findutils

FROM ${UBI_MICRO} AS server
ARG KEYCLOAK_VERSION SOURCE_COMMIT_KEYCLOAK
ENV LANG=en_US.UTF-8 KC_RUN_IN_CONTAINER=true
COPY --from=ubi-micro-build /tmp/null/rootfs/ /
COPY --from=ubi-micro-build --chown=1000:0 /opt/keycloak /opt/keycloak
RUN echo "keycloak:x:0:root" >> /etc/group \
 && echo "keycloak:x:1000:0:keycloak user:/opt/keycloak:/sbin/nologin" >> /etc/passwd
LABEL org.opencontainers.image.title="anima identity provider" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.anima.source.keycloak="${SOURCE_COMMIT_KEYCLOAK}"
USER 1000
# The production mode starts an optimized build: the options that are fixed at
# build time (the database vendor, the health endpoints) are given here, once.
RUN /opt/keycloak/bin/kc.sh build --db=postgres --health-enabled=true
EXPOSE 8080 8443 9000
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
