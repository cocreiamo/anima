#!/usr/bin/env bash
#MISE description="Decide whether the commit carries a version to publish: print version=<version> and publish=<true|false>"
#
# Usage: GITHUB_REPOSITORY=<owner/name> mise run promote:plan [manifest file]
#
# The version is the one in the release manifest (default
# .github/release-please-manifest.json). 0.0.0 means none is prepared; a
# version that already has a release is not published again.
set -euo pipefail

root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
manifest="${1:-$root/.github/release-please-manifest.json}"
version="$(jq -r '."."' "$manifest")"

echo "version=$version"
if [ "$version" = "0.0.0" ]; then
  echo "No version prepared yet: nothing to publish." >&2
  echo "publish=false"
elif gh release view "v$version" --repo "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}" >/dev/null 2>&1; then
  echo "v$version is already released: nothing to publish." >&2
  echo "publish=false"
else
  echo "publish=true"
fi
