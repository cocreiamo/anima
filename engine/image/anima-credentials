#!/usr/bin/bash
# Derives, at every start, the credentials that the parts of the engine hand to
# each other, from the root of trust, into memory only (/run is a tmpfs): nothing
# is written to a volume or to an image, and the same root of trust gives the same
# values at every start (the secret store registered the configurator's credential
# on its first start and must be given the same one again).
#
# Output, in $ANIMA_CREDENTIALS_DIR (default /run/anima/configurator):
#   root_of_trust, secret_store_secret_id, identity_provider_admin_password
#       files for the configurator, owned by its user (uid 999)
#   secrets.env, access.env
#       environment files for the secret store and the identity provider
#       (read by podman as root)
set -euo pipefail

dir=${ANIMA_CREDENTIALS_DIR:-/run/anima/configurator}
seal=${ANIMA_ROOT_OF_TRUST:-/var/lib/anima/root-of-trust/seal}
owner=${ANIMA_CONFIGURATOR_UID:-999}

umask 0077
mkdir -p "$dir"

derive() { { cat "$seal"; printf '%s' "$1"; } | sha256sum | cut -d' ' -f1; }

secret_id=$(derive anima-configurator-secret-id)
admin_password=$(derive anima-identity-provider-admin)

install -m 0400 -o "$owner" /dev/null "$dir/secret_store_secret_id.new"
printf '%s' "$secret_id" >"$dir/secret_store_secret_id.new"
install -m 0400 -o "$owner" /dev/null "$dir/identity_provider_admin_password.new"
printf '%s' "$admin_password" >"$dir/identity_provider_admin_password.new"
install -m 0400 -o "$owner" "$seal" "$dir/root_of_trust.new"
printf 'CONFIGURATOR_SECRET_ID=%s\n' "$secret_id" >"$dir/secrets.env.new"
printf 'KC_BOOTSTRAP_ADMIN_USERNAME=admin\nKC_BOOTSTRAP_ADMIN_PASSWORD=%s\n' "$admin_password" >"$dir/access.env.new"

for name in secret_store_secret_id identity_provider_admin_password root_of_trust secrets.env access.env; do
    mv -f "$dir/$name.new" "$dir/$name"
done
