<?xml version="1.0" encoding="utf-8"?>
<!-- The library comes from the one local source, which holds the package whose
     content hash the build has checked (GAP-057); every other package, if any,
     from the public feed, and the lock file pins its content hash. -->
<configuration>
  <packageSources>
    <clear />
    <add key="pinned" value="/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pinned">
      <package pattern="Yarp.ReverseProxy" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
