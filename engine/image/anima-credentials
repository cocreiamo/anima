#!/usr/bin/bash
# Derives, at every start, the credentials that the parts of the engine hand to
# each other, from the root of trust, into memory only (/run is a tmpfs): nothing
# is written to a volume or to an image, and the same root of trust gives the same
# values at every start (the secret store registered the configurator's credential
# on its first start and must be given the same one again).
#
# What a service needs before the configurator can run is derived here; everything
# else is set by the secret store (ADR 0003).
#
# Output, in $ANIMA_CREDENTIALS_DIR (default /run/anima/configurator):
#   root_of_trust, secret_store_secret_id,
#   identity_provider_bootstrap_client_id, identity_provider_bootstrap_secret,
#   identity_provider_configurator_secret, identity_provider_database_password
#       files for the configurator and the database preparation, owned by their
#       user (uid 999)
#   secrets.env, access.env
#       environment files for the secret store and the identity provider
#       (read by podman as root)
#
# The identity provider starts with a temporary administrator, a service account
# (its client id and secret); the configurator makes its own permanent client with
# the configurator secret and deletes the temporary one at its first run.
set -euo pipefail

dir=${ANIMA_CREDENTIALS_DIR:-/run/anima/configurator}
seal=${ANIMA_ROOT_OF_TRUST:-/var/lib/anima/root-of-trust/seal}
owner=${ANIMA_CONFIGURATOR_UID:-999}
bootstrap_client=anima-bootstrap

umask 0077
mkdir -p "$dir"

derive() { { cat "$seal"; printf '%s' "$1"; } | sha256sum | cut -d' ' -f1; }

secret_id=$(derive anima-configurator-secret-id)
bootstrap_secret=$(derive anima-identity-provider-bootstrap)
configurator_secret=$(derive anima-identity-provider-configurator)
database_password=$(derive anima-identity-provider-database)

# file <name> <value>: a file for the configurator's user, readable by it only.
file() {
    install -m 0400 -o "$owner" /dev/null "$dir/$1.new"
    printf '%s' "$2" >"$dir/$1.new"
}
file secret_store_secret_id "$secret_id"
file identity_provider_bootstrap_client_id "$bootstrap_client"
file identity_provider_bootstrap_secret "$bootstrap_secret"
file identity_provider_configurator_secret "$configurator_secret"
file identity_provider_database_password "$database_password"
install -m 0400 -o "$owner" "$seal" "$dir/root_of_trust.new"
printf 'CONFIGURATOR_SECRET_ID=%s\n' "$secret_id" >"$dir/secrets.env.new"
printf 'KC_BOOTSTRAP_ADMIN_CLIENT_ID=%s\nKC_BOOTSTRAP_ADMIN_CLIENT_SECRET=%s\nKC_DB_PASSWORD=%s\n' \
    "$bootstrap_client" "$bootstrap_secret" "$database_password" >"$dir/access.env.new"

for name in secret_store_secret_id identity_provider_bootstrap_client_id identity_provider_bootstrap_secret \
    identity_provider_configurator_secret identity_provider_database_password root_of_trust secrets.env access.env; do
    mv -f "$dir/$name.new" "$dir/$name"
done
