#!/usr/bin/env bash
#MISE description="Move main-green to a commit that passed every verification (a fast-forward, never forced)"
#
# Usage: GITHUB_REPOSITORY=<owner/name> mise run promote:green <commit sha>
#
# The branch is created when it does not exist and updated with force=false
# when it does, so that GitHub refuses anything but a fast-forward.
set -euo pipefail

sha="${1:?usage: promote:green <commit sha>}"
repo="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}"

if gh api "repos/$repo/git/ref/heads/main-green" --silent 2>/dev/null; then
  gh api --method PATCH "repos/$repo/git/refs/heads/main-green" \
    -f sha="$sha" -F force=false --silent
else
  gh api --method POST "repos/$repo/git/refs" \
    -f ref=refs/heads/main-green -f sha="$sha" --silent
fi
